From: WinNative
Subject: [PATCH] freedreno: enable the UBWC flag hint for A740

Enable the texture-processor UBWC hint for FD740 and Adreno X1-85.
Converted from WinNative's GPU-property script.
---
diff --git a/src/freedreno/common/freedreno_devices.py b/src/freedreno/common/freedreno_devices.py
index afe34e8..fa5817e 100644
--- a/src/freedreno/common/freedreno_devices.py
+++ b/src/freedreno/common/freedreno_devices.py
@@ -1289,7 +1289,8 @@ add_gpus([
         GPUId(chip_id=0xffff43050c01, name="Adreno X1-85"),
     ], A6xxGPUInfo(
         CHIP.A7XX,
-        [a7xx_base, a7xx_gen2, GPUProps(mutable_ubwc_min_pixels = 65536)],
+        [a7xx_base, a7xx_gen2, GPUProps(enable_tp_ubwc_flag_hint = True,
+                                        mutable_ubwc_min_pixels = 65536)],
         num_ccu = 6,
         tile_align_w = 96,
         tile_align_h = 32,
