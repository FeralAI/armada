#!/usr/bin/python3
"""Convert Steam's backlight write into the selected panel's raw range."""

import math
from pathlib import Path
import sys


def brightness_value(value, source_max, target_max, scale):
    if source_max <= 0 or target_max <= 0 or not 0 <= value <= source_max:
        raise ValueError("invalid backlight value or range")
    if scale != "non-linear":
        return value * target_max // source_max

    minimum = (target_max + 19) // 20  # 5% of the raw range, rounded up.
    if value == 0:
        return minimum

    # Steam's display curve recheck this curve if Steam changes its backlight backend.
    points = ((0.0, math.log2(0.01)), (0.5, -1.75), (0.9, -0.25), (1.0, 0.0))
    light = math.log2(value / source_max)
    position = 0.0
    for (x0, y0), (x1, y1) in zip(points, points[1:]):
        if light <= y1:
            position = x0 + (light - y0) * (x1 - x0) / (y1 - y0)
            break
    position = max(0.0, min(1.0, position))
    return minimum + int(position * (target_max - minimum) + 0.5)


def main(args):
    if len(args) != 3:
        raise ValueError("expected value, source directory, target directory")
    value, source, target = args
    source, target = Path(source), Path(target)
    try:
        scale = (target / "scale").read_text().strip()
    except FileNotFoundError:
        scale = "unknown"
    print(brightness_value(int(value), int((source / "max_brightness").read_text()),
                           int((target / "max_brightness").read_text()),
                           scale))


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, ValueError) as error:
        print(f"steam-backlight-value: {error}", file=sys.stderr)
        sys.exit(1)
